# Скопируй в .env и заполни: cp .env.example .env
# Значения в одинарных кавычках — файл подключается через `. ./.env` (см. README)

# Вуз: список — python -m modeus_sync --list
UNIVERSITY='urfu'
UNIVERSITY_LOGIN='ivanov.ii@urfu.me'
UNIVERSITY_PASSWORD='password'

# Куда писать: caldav | ics
TARGET='caldav'

# CalDAV. Для Яндекса — логин и пароль приложения «Календарь (CalDAV)»
# CALDAV_URL='https://caldav.yandex.ru'
CALDAV_LOGIN='ivanov'
CALDAV_PASSWORD='app-password'

# Для TARGET=ics
# ICS_PATH='schedule.ics'

# Необязательные
# CALENDAR_NAME='Modeus УрФУ'
DAYS_BACK=7
DAYS_AHEAD=60
